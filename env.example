import { useState, useEffect, useRef } from "react";
import mammoth from "mammoth";
import JSZip from "jszip";
import * as XLSX from "xlsx";

const API_KEY = import.meta.env.VITE_ANTHROPIC_API_KEY || "";

const POMODORO_DEFAULTS = { study: 25 * 60, shortBreak: 5 * 60, longBreak: 15 * 60 };
const STUDY_METHODS = [
  { id: "flashcards", icon: "🃏", label: "Flash Cards", desc: "Flip & test yourself" },
  { id: "mindmap", icon: "🧠", label: "Mind Map", desc: "See how ideas connect" },
  { id: "quiz", icon: "✏️", label: "Quiz Me", desc: "AI-generated questions" },
  { id: "simplify", icon: "💡", label: "Simplify", desc: "ELI5 explanations" },
  { id: "pomodoro", icon: "🍅", label: "Pomodoro Timer", desc: "Focus in timed bursts" },
  { id: "summary", icon: "📝", label: "Summary Notes", desc: "Key points at a glance" },
];
const EXAMPLE_MATERIAL = `Photosynthesis is the process by which green plants convert light energy into chemical energy. It occurs in the chloroplasts, specifically using chlorophyll. The overall equation is: 6CO₂ + 6H₂O → C₆H₁₂O₆ + 6O₂. The process has two stages: Light-dependent reactions (in thylakoid membranes) and the Calvin Cycle (in the stroma). Light reactions produce ATP and NADPH. The Calvin Cycle uses these to fix carbon dioxide into glucose. Factors affecting photosynthesis include light intensity, carbon dioxide concentration, and temperature. Plants use glucose for energy (respiration), growth, and storage as starch.`;

// ─── API ───
async function askClaude(prompt, systemPrompt) {
  try {
    const res = await fetch("https://api.anthropic.com/v1/messages", {
      method: "POST", headers: { "Content-Type": "application/json", "x-api-key": API_KEY, "anthropic-version": "2023-06-01" },
      body: JSON.stringify({ model: "claude-sonnet-4-20250514", max_tokens: 1500,
        system: systemPrompt || "You help a 14-year-old student study. Use simple language and analogies. Respond ONLY with valid JSON. No markdown fences, no backticks, no extra text.",
        messages: [{ role: "user", content: prompt }] }),
    });
    if (!res.ok) return { error: "API error " + res.status };
    const data = await res.json();
    const text = (data.content || []).map(b => b.text || "").join("");
    if (!text.trim()) return { error: "Empty AI response" };
    let cleaned = text.replace(/```json\s*/g, "").replace(/```\s*/g, "").trim();
    const f = cleaned.indexOf("{"), l = cleaned.lastIndexOf("}");
    if (f !== -1 && l !== -1) cleaned = cleaned.slice(f, l + 1);
    return JSON.parse(cleaned);
  } catch (e) { console.error(e); return { error: "Network error — check connection" }; }
}

// ─── File Extraction ───
function getFileCategory(file) {
  const n = (file.name || "").toLowerCase(), t = (file.type || "").toLowerCase();
  if (t.startsWith("image/") || /\.(png|jpg|jpeg|gif|webp|bmp)$/.test(n)) return "image";
  if (t === "application/pdf" || n.endsWith(".pdf")) return "pdf";
  if (n.endsWith(".docx")) return "docx";
  if (n.endsWith(".pptx")) return "pptx";
  if (n.endsWith(".xlsx") || n.endsWith(".xls")) return "xlsx";
  if (/\.(txt|csv|md)$/.test(n)) return "text";
  return "unknown";
}
function getFileIcon(cat, name) {
  return { image:"🖼️", pdf:"📄", text:"📝", docx:"📃", pptx:"📊", xlsx:"📗" }[cat] || "📎";
}
async function fileToBase64(f) {
  return new Promise(r => { const rd = new FileReader(); rd.onload = () => r(rd.result.split(",")[1]); rd.readAsDataURL(f); });
}
async function extractFromImage(b64, mt) {
  try {
    const r = await fetch("https://api.anthropic.com/v1/messages", { method:"POST", headers:{"Content-Type":"application/json","x-api-key":API_KEY,"anthropic-version":"2023-06-01"},
      body: JSON.stringify({ model:"claude-sonnet-4-20250514", max_tokens:2000, messages:[{role:"user",content:[
        {type:"image",source:{type:"base64",media_type:mt,data:b64}},
        {type:"text",text:"Extract ALL text from this image. Include everything visible. Return ONLY the extracted text."}]}]})});
    if (!r.ok) return {text:"",error:"Image error "+r.status};
    const d = await r.json(); return {text:(d.content||[]).map(b=>b.text||"").join(""),error:null};
  } catch(e) { return {text:"",error:"Failed to read image"}; }
}
async function extractFromPDF(b64) {
  try {
    const r = await fetch("https://api.anthropic.com/v1/messages", { method:"POST", headers:{"Content-Type":"application/json","x-api-key":API_KEY,"anthropic-version":"2023-06-01"},
      body: JSON.stringify({ model:"claude-sonnet-4-20250514", max_tokens:3000, messages:[{role:"user",content:[
        {type:"document",source:{type:"base64",media_type:"application/pdf",data:b64}},
        {type:"text",text:"Extract ALL text from this PDF. Preserve structure. Return ONLY the text."}]}]})});
    if (!r.ok) return {text:"",error:"PDF error "+r.status};
    const d = await r.json(); return {text:(d.content||[]).map(b=>b.text||"").join(""),error:null};
  } catch(e) { return {text:"",error:"Failed to read PDF"}; }
}
async function extractFromDocx(file) {
  try { const ab = await file.arrayBuffer(); const r = await mammoth.extractRawText({arrayBuffer:ab}); return {text:(r.value||"").trim(),error:null}; }
  catch(e) { return {text:"",error:"Failed to read .docx — make sure it's a .docx file"}; }
}
async function extractFromPptx(file) {
  try {
    const ab = await file.arrayBuffer(), zip = await JSZip.loadAsync(ab);
    const slides = Object.keys(zip.files).filter(n=>/^ppt\/slides\/slide\d+\.xml$/.test(n)).sort((a,b)=>parseInt(a.match(/\d+/)[0])-parseInt(b.match(/\d+/)[0]));
    let all = ""; for (const sp of slides) { const xml = await zip.files[sp].async("string"); const doc = new DOMParser().parseFromString(xml,"application/xml");
      const ts = doc.getElementsByTagNameNS("http://schemas.openxmlformats.org/drawingml/2006/main","t"); const txts = [];
      for (let i=0;i<ts.length;i++) { const t=(ts[i].textContent||"").trim(); if(t) txts.push(t); }
      if (txts.length) all += "\n\n--- Slide "+sp.match(/\d+/)[0]+" ---\n"+txts.join("\n"); }
    return {text:all.trim(),error:all.trim()?"":null};
  } catch(e) { return {text:"",error:"Failed to read PowerPoint"}; }
}
async function extractFromXlsx(file) {
  try { const ab = await file.arrayBuffer(), wb = XLSX.read(ab,{type:"array"}); let all="";
    for (const sn of wb.SheetNames) { const csv=XLSX.utils.sheet_to_csv(wb.Sheets[sn]); if(csv.trim()) all+="\n\n--- "+sn+" ---\n"+csv.trim(); }
    return {text:all.trim(),error:null}; } catch(e) { return {text:"",error:"Failed to read spreadsheet"}; }
}
async function extractTextFromFile(file) {
  const cat = getFileCategory(file);
  if (cat==="image") { const b=await fileToBase64(file); return extractFromImage(b,file.type||"image/jpeg"); }
  if (cat==="pdf") { const b=await fileToBase64(file); return extractFromPDF(b); }
  if (cat==="text") { try { return {text:(await file.text()).trim(),error:null}; } catch(e) { return {text:"",error:"Read error"}; } }
  if (cat==="docx") return extractFromDocx(file);
  if (cat==="pptx") return extractFromPptx(file);
  if (cat==="xlsx") return extractFromXlsx(file);
  try { const t = await file.text(); if (t.trim().length > 20) return {text:t.trim(),error:null}; } catch(e) {}
  return {text:"",error:"Unsupported file type: "+((file.name||"").split(".").pop())};
}

// ─── Shared UI ───
function ErrorBox({ message, onRetry }) {
  return (<div style={{textAlign:"center",padding:32}}><div style={{fontSize:36,marginBottom:12}}>😕</div>
    <div style={{fontSize:15,color:"#FF6B4A",fontWeight:600,marginBottom:8}}>Something went wrong</div>
    <div style={{fontSize:13,color:"rgba(255,255,255,0.5)",marginBottom:20,maxWidth:340,margin:"0 auto 20px"}}>{message}</div>
    {onRetry && <button onClick={onRetry} style={{padding:"10px 28px",borderRadius:20,border:"none",background:"#FF6B4A",color:"#fff",fontWeight:700,cursor:"pointer",fontSize:14}}>Try Again</button>}
  </div>);
}
function TipBox({ color, title, text }) {
  return (<div style={{marginTop:20,background:"rgba(255,255,255,0.05)",borderRadius:12,padding:16,textAlign:"left",fontSize:13,color:"rgba(255,255,255,0.6)",lineHeight:1.7}}>
    <strong style={{color}}>{title}</strong><br/>{text}</div>);
}
function Spinner() { return <span style={{display:"inline-block",width:14,height:14,border:"2px solid rgba(255,255,255,0.3)",borderTopColor:"#4ECDC4",borderRadius:"50%",animation:"spin 0.8s linear infinite"}}/>; }

// ─── Print / Download Functionality ───
// The artifact sandbox blocks window.open() and window.print(), so we use
// a two-pronged approach:
//   1. Show a print-friendly preview INLINE (renders inside the app in an
//      overlay with light theme styling)
//   2. Offer a "Download as HTML" button — the student downloads the file,
//      opens it in their browser, and prints from there
//
// Think of it like a teacher making a handout: we create a clean document,
// let them preview it, and give them the file to take home and print.

function buildPrintHTML(title, bodyContent) {
  return '<!DOCTYPE html><html><head><meta charset="utf-8"><title>' + title + ' — Study Buddy</title>\n<style>\n@import url("https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;600;700&display=swap");\n* { box-sizing: border-box; margin: 0; padding: 0; }\nbody { font-family: "DM Sans", "Segoe UI", sans-serif; padding: 40px; color: #1a1a2e; line-height: 1.7; max-width: 800px; margin: 0 auto; }\nh1 { font-size: 24px; margin-bottom: 6px; }\nh2 { font-size: 18px; margin: 24px 0 12px; color: #333; border-bottom: 2px solid #eee; padding-bottom: 6px; }\n.subtitle { font-size: 13px; color: #888; margin-bottom: 24px; }\n.card { border: 1px solid #ddd; border-radius: 12px; padding: 16px; margin-bottom: 12px; page-break-inside: avoid; }\n.card-q { font-weight: 700; font-size: 15px; margin-bottom: 6px; }\n.card-a { color: #555; font-size: 14px; }\n.branch { border: 1px solid #ddd; border-radius: 12px; padding: 14px; margin-bottom: 10px; page-break-inside: avoid; }\n.branch-title { font-weight: 700; font-size: 15px; margin-bottom: 6px; }\n.branch ul { padding-left: 20px; margin: 0; }\n.branch li { margin-bottom: 4px; font-size: 13px; }\n.quiz-q { margin-bottom: 16px; page-break-inside: avoid; }\n.quiz-q h3 { font-size: 14px; font-weight: 700; margin-bottom: 8px; }\n.quiz-opt { padding: 6px 0; font-size: 13px; }\n.quiz-opt.correct { font-weight: 700; color: #2a7a5a; }\n.quiz-exp { font-size: 12px; color: #666; margin-top: 6px; font-style: italic; }\n.section { border-left: 3px solid #FF6B4A; padding-left: 16px; margin-bottom: 20px; page-break-inside: avoid; }\n.section-title { font-weight: 700; font-size: 15px; margin-bottom: 4px; }\n.analogy { font-size: 13px; color: #2a7a5a; margin-top: 8px; }\n.key-point { display: flex; gap: 10px; margin-bottom: 10px; align-items: flex-start; }\n.point-num { min-width: 24px; height: 24px; border-radius: 50%; background: #FF6B4A; color: #fff; font-size: 12px; font-weight: 700; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }\n.term { margin-bottom: 6px; font-size: 13px; }\n.term-word { font-weight: 700; color: #2a7a5a; }\n</style></head><body>\n<h1>' + title + '</h1>\n<div class="subtitle">Generated by Study Buddy — ' + new Date().toLocaleDateString("en-GB",{day:"numeric",month:"long",year:"numeric"}) + '</div>\n' + bodyContent + '\n</body></html>';
}

function esc(str) { return (str||"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"); }

function buildPrintContent(method, studyData) {
  switch (method) {
    case "flashcards": {
      const cards = studyData.flashcards && studyData.flashcards.cards;
      if (!cards || !cards.length) return null;
      let html = "<h2>Flash Cards (" + cards.length + " cards)</h2>";
      cards.forEach((c, i) => { html += '<div class="card"><div class="card-q">Q' + (i+1) + ': ' + esc(c.question) + '</div><div class="card-a">A: ' + esc(c.answer) + '</div></div>'; });
      return { title: "Flash Cards", html };
    }
    case "mindmap": {
      const d = studyData.mindmap;
      if (!d || !d.branches) return null;
      let html = '<h2 style="text-align:center;border:2px solid #FF6B4A;border-radius:12px;padding:12px;">' + esc(d.center || "Main Topic") + '</h2>';
      d.branches.forEach(b => { html += '<div class="branch"><div class="branch-title">' + esc(b.topic) + '</div><ul>'; (b.points || []).forEach(p => { html += '<li>' + esc(p) + '</li>'; }); html += '</ul></div>'; });
      return { title: "Mind Map", html };
    }
    case "quiz": {
      const qs = studyData.quiz && studyData.quiz.questions;
      if (!qs || !qs.length) return null;
      let html = "<h2>Quiz (" + qs.length + " questions)</h2>";
      qs.forEach((q, i) => { html += '<div class="quiz-q"><h3>Q' + (i+1) + ': ' + esc(q.question) + '</h3>';
        (q.options || []).forEach((opt, j) => { const isC = j === q.correctIndex; html += '<div class="quiz-opt' + (isC ? " correct" : "") + '">' + String.fromCharCode(65+j) + ') ' + esc(opt) + (isC ? " ✓" : "") + '</div>'; });
        if (q.explanation) html += '<div class="quiz-exp">' + esc(q.explanation) + '</div>'; html += '</div>'; });
      return { title: "Quiz", html };
    }
    case "simplify": {
      const c = studyData.simplify;
      if (!c || !c.sections) return null;
      let html = "<h2>Simplified Explanations</h2>";
      c.sections.forEach(s => { html += '<div class="section"><div class="section-title">' + esc(s.title) + '</div><div>' + esc(s.simple) + '</div>';
        if (s.analogy) html += '<div class="analogy">Analogy: ' + esc(s.analogy) + '</div>'; html += '</div>'; });
      return { title: "Simplified Notes", html };
    }
    case "summary": {
      const s = studyData.summary;
      if (!s || !s.keyPoints) return null;
      let html = ""; if (s.title) html += "<h2>" + esc(s.title) + "</h2>";
      html += "<h2>Key Points</h2>";
      s.keyPoints.forEach((p, i) => { html += '<div class="key-point"><div class="point-num">' + (i+1) + '</div><div>' + esc(p) + '</div></div>'; });
      if (s.keyTerms && s.keyTerms.length) { html += "<h2>Key Terms</h2>"; s.keyTerms.forEach(t => { html += '<div class="term"><span class="term-word">' + esc(t.term) + '</span> — ' + esc(t.definition) + '</div>'; }); }
      return { title: "Summary Notes", html };
    }
    default: return null;
  }
}

function downloadHTMLFile(method, studyData) {
  const content = buildPrintContent(method, studyData);
  if (!content) return;
  const fullHTML = buildPrintHTML(content.title, content.html);
  const blob = new Blob([fullHTML], { type: "text/html" });
  const url = URL.createObjectURL(blob);
  const a = document.createElement("a");
  a.href = url;
  a.download = "study-buddy-" + method + ".html";
  document.body.appendChild(a);
  a.click();
  document.body.removeChild(a);
  URL.revokeObjectURL(url);
}

// PDF export: we render the content into a hidden iframe, then trigger
// the browser's print dialog on that iframe. When you choose "Save as PDF"
// in the print dialog (every modern browser has this), you get a proper PDF.
// Think of it like putting a document on a photocopier — the iframe is the
// glass, and the browser's print dialog is the "copy" button.
function printAsPDF(method, studyData) {
  const content = buildPrintContent(method, studyData);
  if (!content) return;
  const fullHTML = buildPrintHTML(content.title, content.html);

  // Remove any existing print iframe
  const existing = document.getElementById("study-buddy-print-frame");
  if (existing) existing.remove();

  const iframe = document.createElement("iframe");
  iframe.id = "study-buddy-print-frame";
  iframe.style.cssText = "position:fixed;top:-10000px;left:-10000px;width:800px;height:600px;border:none;";
  document.body.appendChild(iframe);

  const doc = iframe.contentDocument || iframe.contentWindow.document;
  doc.open();
  doc.write(fullHTML);
  doc.close();

  // Wait for content + fonts to load, then trigger print
  iframe.onload = () => {
    setTimeout(() => {
      try {
        iframe.contentWindow.focus();
        iframe.contentWindow.print();
      } catch (e) {
        // If iframe print fails (some sandbox restrictions), fall back to download
        downloadHTMLFile(method, studyData);
      }
      // Clean up after a delay
      setTimeout(() => { try { iframe.remove(); } catch(e) {} }, 2000);
    }, 500);
  };
}

// Print preview overlay — shows content preview + two export buttons
function PrintPreview({ method, studyData, onClose }) {
  const content = buildPrintContent(method, studyData);
  if (!content) return null;
  const [exporting, setExporting] = useState(false);

  const handlePDF = () => {
    setExporting(true);
    printAsPDF(method, studyData);
    setTimeout(() => setExporting(false), 2000);
  };

  return (
    <div style={{position:"fixed",inset:0,zIndex:9999,background:"rgba(0,0,0,0.7)",display:"flex",alignItems:"center",justifyContent:"center",padding:20}}
      onClick={onClose}>
      <div onClick={e => e.stopPropagation()} style={{
        background:"#fff",borderRadius:20,maxWidth:700,width:"100%",maxHeight:"85vh",display:"flex",flexDirection:"column",overflow:"hidden",boxShadow:"0 20px 60px rgba(0,0,0,0.5)"
      }}>
        {/* Header with export options */}
        <div style={{padding:"16px 20px",borderBottom:"1px solid #eee",flexShrink:0}}>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12}}>
            <div style={{fontSize:16,fontWeight:700,color:"#1a1a2e"}}>🖨️ Export & Print</div>
            <button onClick={onClose} style={{width:32,height:32,borderRadius:"50%",border:"1px solid #ddd",background:"#f5f5f5",cursor:"pointer",fontSize:16,display:"flex",alignItems:"center",justifyContent:"center",color:"#666"}}>✕</button>
          </div>
          <div style={{display:"flex",gap:10,flexWrap:"wrap"}}>
            <button onClick={handlePDF} disabled={exporting} style={{
              padding:"10px 20px",borderRadius:14,border:"none",background:"#FF6B4A",color:"#fff",fontWeight:700,fontSize:13,cursor:exporting?"wait":"pointer",
              display:"flex",alignItems:"center",gap:8,opacity:exporting?0.7:1,flex:1,justifyContent:"center",minWidth:140
            }}>
              📄 {exporting ? "Opening print..." : "Save as PDF"}
            </button>
            <button onClick={() => downloadHTMLFile(method, studyData)} style={{
              padding:"10px 20px",borderRadius:14,border:"1px solid #ddd",background:"#fff",color:"#333",fontWeight:700,fontSize:13,cursor:"pointer",
              display:"flex",alignItems:"center",gap:8,flex:1,justifyContent:"center",minWidth:140
            }}>
              🌐 Download as HTML
            </button>
          </div>
          <div style={{fontSize:11,color:"#aaa",marginTop:8}}>
            PDF: opens your browser's print dialog — choose "Save as PDF" as the printer.
            HTML: downloads a file you can open and print anytime.
          </div>
        </div>

        {/* Scrollable preview */}
        <div style={{overflow:"auto",padding:"24px 28px",flex:1}}>
          <h1 style={{fontSize:22,fontWeight:800,color:"#1a1a2e",marginBottom:4}}>{content.title}</h1>
          <div style={{fontSize:12,color:"#999",marginBottom:20}}>Generated by Study Buddy — {new Date().toLocaleDateString("en-GB",{day:"numeric",month:"long",year:"numeric"})}</div>
          <div dangerouslySetInnerHTML={{__html: content.html}} style={{color:"#1a1a2e",fontSize:14,lineHeight:1.7}} />
        </div>
      </div>
    </div>
  );
}

function PrintButton({ method, studyData, onPrint }) {
  const hasContent = method && method !== "pomodoro" && studyData[method];
  if (!hasContent) return null;
  return (
    <button onClick={onPrint} title="Print / Save as PDF"
      style={{width:32,height:32,borderRadius:"50%",border:"none",cursor:"pointer",display:"inline-flex",alignItems:"center",justifyContent:"center",
        background:"rgba(255,255,255,0.08)",fontSize:15,color:"rgba(255,255,255,0.5)",transition:"all 0.2s",padding:0,flexShrink:0}}>
      🖨️
    </button>
  );
}

function GenerateMoreBtn({ onClick, loading, label }) {
  return (
    <button onClick={onClick} disabled={loading} style={{
      display:"flex",alignItems:"center",gap:8,margin:"20px auto 0",padding:"10px 24px",borderRadius:20,
      border:"1px solid rgba(78,205,196,0.3)",background:"rgba(78,205,196,0.08)",color:"#4ECDC4",
      fontWeight:700,fontSize:13,cursor:loading?"wait":"pointer",opacity:loading?0.6:1,transition:"all 0.2s",
    }}>
      {loading ? <Spinner/> : "🔄"} {loading ? "Generating..." : (label || "Generate More")}
    </button>
  );
}

// ─── Pomodoro ───
function PomodoroTimer() {
  const [mode,setMode]=useState("study"); const [timeLeft,setTimeLeft]=useState(POMODORO_DEFAULTS.study);
  const [running,setRunning]=useState(false); const [sessions,setSessions]=useState(0); const iv=useRef(null);
  useEffect(()=>{
    if(running&&timeLeft>0) iv.current=setInterval(()=>setTimeLeft(t=>t-1),1000);
    else if(timeLeft===0&&running){setRunning(false);if(mode==="study"){setSessions(s=>s+1);const nm=(sessions+1)%4===0?"longBreak":"shortBreak";setMode(nm);setTimeLeft(POMODORO_DEFAULTS[nm]);}else{setMode("study");setTimeLeft(POMODORO_DEFAULTS.study);}}
    return()=>clearInterval(iv.current);
  },[running,timeLeft,mode,sessions]);
  const sw=m=>{setMode(m);setTimeLeft(POMODORO_DEFAULTS[m]);setRunning(false);};
  const mn=String(Math.floor(timeLeft/60)).padStart(2,"0"), sc=String(timeLeft%60).padStart(2,"0"), pct=((POMODORO_DEFAULTS[mode]-timeLeft)/POMODORO_DEFAULTS[mode])*100;
  return (<div style={{textAlign:"center"}}>
    <div style={{display:"flex",gap:8,justifyContent:"center",marginBottom:24,flexWrap:"wrap"}}>
      {[["study","📚 Study"],["shortBreak","☕ Short Break"],["longBreak","🌿 Long Break"]].map(([k,l])=>
        <button key={k} onClick={()=>sw(k)} style={{padding:"8px 16px",borderRadius:20,border:"none",cursor:"pointer",fontSize:13,fontWeight:600,background:mode===k?"#FF6B4A":"rgba(255,255,255,0.1)",color:mode===k?"#fff":"rgba(255,255,255,0.6)"}}>{l}</button>)}
    </div>
    <div style={{position:"relative",width:200,height:200,margin:"0 auto 24px"}}>
      <svg viewBox="0 0 200 200" style={{transform:"rotate(-90deg)"}}><circle cx="100" cy="100" r="90" fill="none" stroke="rgba(255,255,255,0.08)" strokeWidth="8"/>
        <circle cx="100" cy="100" r="90" fill="none" stroke="#FF6B4A" strokeWidth="8" strokeDasharray={565} strokeDashoffset={565-(pct/100)*565} strokeLinecap="round" style={{transition:"stroke-dashoffset 0.5s"}}/></svg>
      <div style={{position:"absolute",inset:0,display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center"}}>
        <div style={{fontFamily:"'Space Mono',monospace",fontSize:48,fontWeight:700,color:"#fff",letterSpacing:2}}>{mn}:{sc}</div>
        <div style={{fontSize:12,color:"rgba(255,255,255,0.5)",textTransform:"uppercase",letterSpacing:2}}>{mode==="study"?"Focus Time":"Break"}</div></div>
    </div>
    <div style={{display:"flex",gap:12,justifyContent:"center"}}>
      <button onClick={()=>setRunning(!running)} style={{padding:"12px 32px",borderRadius:24,border:"none",cursor:"pointer",fontSize:16,fontWeight:700,background:running?"rgba(255,255,255,0.15)":"#FF6B4A",color:"#fff"}}>{running?"⏸ Pause":"▶ Start"}</button>
      <button onClick={()=>{setRunning(false);setTimeLeft(POMODORO_DEFAULTS[mode]);}} style={{padding:"12px 20px",borderRadius:24,border:"1px solid rgba(255,255,255,0.2)",background:"transparent",color:"#fff",cursor:"pointer",fontSize:16}}>↺</button>
    </div>
    <div style={{marginTop:20,fontSize:13,color:"rgba(255,255,255,0.5)"}}>🍅 Sessions: <span style={{color:"#FF6B4A",fontWeight:700}}>{sessions}</span></div>
    <TipBox color="#FF6B4A" title="Pomodoro Method:" text="Like interval training for your brain! 25 mins focus, 5 min break, repeat. After 4 rounds take a 15 min break. Your brain learns better in bursts — like a muscle needing rest between sets."/>
  </div>);
}

// ─── Flash Cards — growing deck ───
function FlashCards({ cards, onMore, generating }) {
  const [idx,setIdx]=useState(0); const [flipped,setFlipped]=useState(false); const [known,setKnown]=useState(new Set());
  useEffect(()=>{if(cards&&idx>=cards.length) setIdx(Math.max(0,cards.length-1));},[cards]);
  if(!cards||!cards.length) return null;
  const card=cards[idx], progress=(known.size/cards.length)*100;
  const next=gotIt=>{ if(gotIt){const s=new Set(known);s.add(idx);setKnown(s);} setFlipped(false); setIdx((idx+1)%cards.length); };
  return (<div style={{textAlign:"center"}}>
    <div style={{marginBottom:16,fontSize:13,color:"rgba(255,255,255,0.5)"}}>Card {idx+1} of {cards.length} — {known.size} mastered</div>
    <div style={{height:6,background:"rgba(255,255,255,0.08)",borderRadius:3,marginBottom:24,overflow:"hidden"}}>
      <div style={{height:"100%",width:progress+"%",background:"linear-gradient(90deg,#4ECDC4,#44D4A0)",borderRadius:3,transition:"width 0.5s"}}/></div>
    <div onClick={()=>setFlipped(!flipped)} style={{minHeight:200,padding:32,borderRadius:20,cursor:"pointer",display:"flex",flexDirection:"column",alignItems:"center",justifyContent:"center",gap:16,
      background:flipped?"linear-gradient(135deg,#2D5A4E,#1a3a30)":"linear-gradient(135deg,#2a2a4a,#1a1a3a)",border:"1px solid rgba(255,255,255,0.1)",transition:"all 0.3s",position:"relative",userSelect:"none"}}>
      <div style={{position:"absolute",top:12,right:16,fontSize:11,color:"rgba(255,255,255,0.3)",textTransform:"uppercase",letterSpacing:1}}>{flipped?"Answer":"Question"} — tap to flip</div>
      <div style={{fontSize:flipped?17:19,color:"#fff",fontWeight:flipped?400:600,lineHeight:1.6,maxWidth:400}}>{flipped?card.answer:card.question}</div>
    </div>
    <div style={{display:"flex",gap:12,justifyContent:"center",marginTop:20}}>
      <button onClick={()=>next(true)} style={{padding:"10px 24px",borderRadius:20,border:"none",background:"#44D4A0",color:"#1a1a2e",fontWeight:700,cursor:"pointer"}}>✓ Got it!</button>
      <button onClick={()=>next(false)} style={{padding:"10px 24px",borderRadius:20,border:"1px solid rgba(255,255,255,0.2)",background:"transparent",color:"#fff",cursor:"pointer"}}>✗ Need practice</button>
    </div>
    <GenerateMoreBtn onClick={onMore} loading={generating} label="Add More Cards"/>
    <TipBox color="#4ECDC4" title="Active Recall:" text="Every time you TRY to remember before flipping, you train your brain to find that file faster. Guessing first — even wrong — helps more than just reading!"/>
  </div>);
}

// ─── Mind Map ───
function MindMapView({ data, onMore, generating }) {
  if(!data||!data.branches) return null;
  const colors=["#FF6B4A","#4ECDC4","#FFD93D","#A78BFA","#F472B6","#34D399"];
  return (<div>
    <div style={{background:"linear-gradient(135deg,rgba(255,107,74,0.15),rgba(78,205,196,0.1))",borderRadius:20,padding:28,textAlign:"center",border:"2px solid rgba(255,107,74,0.3)",marginBottom:20}}>
      <div style={{fontSize:20,fontWeight:800,color:"#FF6B4A"}}>{data.center||"Main Topic"}</div></div>
    <div style={{display:"grid",gridTemplateColumns:"1fr 1fr",gap:12}}>
      {data.branches.map((b,i)=><div key={i} style={{background:"linear-gradient(135deg,"+colors[i%colors.length]+"15,"+colors[i%colors.length]+"08)",border:"1px solid "+colors[i%colors.length]+"40",borderRadius:16,padding:16}}>
        <div style={{fontSize:14,fontWeight:700,color:colors[i%colors.length],marginBottom:8}}>{b.topic}</div>
        <ul style={{margin:0,paddingLeft:16,fontSize:13,color:"rgba(255,255,255,0.7)",lineHeight:1.8}}>{(b.points||[]).map((p,j)=><li key={j}>{p}</li>)}</ul></div>)}</div>
    <GenerateMoreBtn onClick={onMore} loading={generating} label="New Perspective"/>
    <TipBox color="#A78BFA" title="Mind Maps:" text="Like a spider's web 🕸️ — main idea in the centre, threads connect to smaller ideas. Your brain thinks in connections, not lists!"/>
  </div>);
}

// ─── Quiz — always fresh ───
function QuizView({ questions, onMore, generating }) {
  const [cur,setCur]=useState(0); const [sel,setSel]=useState(null); const [score,setScore]=useState(0); const [done,setDone]=useState(false);
  // Reset quiz state when new questions arrive
  const prevLen = useRef(0);
  useEffect(()=>{ if(questions && questions.length !== prevLen.current) { setCur(0);setSel(null);setScore(0);setDone(false);prevLen.current=questions.length; } },[questions]);
  if(!questions||!questions.length) return null;
  if(done){ const pct=Math.round(score/questions.length*100); return (<div style={{textAlign:"center",padding:32}}>
    <div style={{fontSize:56,marginBottom:12}}>{pct>=80?"🎉":pct>=50?"💪":"📚"}</div>
    <div style={{fontSize:28,fontWeight:800,color:"#fff",marginBottom:6}}>{pct}%</div>
    <div style={{fontSize:15,color:"rgba(255,255,255,0.6)",marginBottom:20}}>{score}/{questions.length} correct</div>
    <div style={{fontSize:14,color:"rgba(255,255,255,0.5)",marginBottom:24}}>{pct>=80?"Amazing!":pct>=50?"Good effort — review what you missed!":"No worries — flashcards then try again!"}</div>
    <div style={{display:"flex",gap:12,justifyContent:"center",flexWrap:"wrap"}}>
      <button onClick={()=>{setCur(0);setSel(null);setScore(0);setDone(false);}} style={{padding:"12px 28px",borderRadius:24,border:"none",background:"rgba(255,255,255,0.12)",color:"#fff",fontWeight:700,cursor:"pointer"}}>Retry Same</button>
      <GenerateMoreBtn onClick={onMore} loading={generating} label="New Quiz"/>
    </div></div>); }
  const q=questions[cur], opts=q.options||[];
  return (<div>
    <div style={{marginBottom:16,display:"flex",justifyContent:"space-between",alignItems:"center"}}>
      <span style={{fontSize:13,color:"rgba(255,255,255,0.5)"}}>Q {cur+1}/{questions.length}</span>
      <span style={{fontSize:13,color:"#44D4A0"}}>Score: {score}</span></div>
    <div style={{height:4,background:"rgba(255,255,255,0.08)",borderRadius:2,marginBottom:24,overflow:"hidden"}}>
      <div style={{height:"100%",width:(cur/questions.length*100)+"%",background:"#FF6B4A",transition:"width 0.3s"}}/></div>
    <div style={{fontSize:17,fontWeight:700,color:"#fff",marginBottom:20,lineHeight:1.5}}>{q.question}</div>
    <div style={{display:"flex",flexDirection:"column",gap:10}}>
      {opts.map((opt,i)=>{ const ans=sel!==null,isC=i===q.correctIndex,isS=sel===i;
        let bg="rgba(255,255,255,0.05)",bd="rgba(255,255,255,0.1)";
        if(ans&&isC){bg="rgba(68,212,160,0.15)";bd="#44D4A0";}else if(ans&&isS&&!isC){bg="rgba(255,107,74,0.15)";bd="#FF6B4A";}
        return <button key={i} disabled={ans} onClick={()=>{setSel(i);if(isC)setScore(s=>s+1);}}
          style={{padding:"14px 18px",borderRadius:12,border:"1px solid "+bd,background:bg,color:"#fff",textAlign:"left",fontSize:14,cursor:ans?"default":"pointer",transition:"all 0.2s"}}>
          <span style={{fontWeight:600,marginRight:10,color:"rgba(255,255,255,0.4)"}}>{String.fromCharCode(65+i)}</span>{opt}</button>; })}</div>
    {sel!==null&&<div style={{marginTop:16}}>
      {q.explanation&&<div style={{fontSize:13,color:"rgba(255,255,255,0.6)",background:"rgba(255,255,255,0.05)",padding:14,borderRadius:12,marginBottom:12,lineHeight:1.6}}>💡 {q.explanation}</div>}
      <button onClick={()=>{if(cur<questions.length-1){setCur(c=>c+1);setSel(null);}else setDone(true);}}
        style={{padding:"10px 28px",borderRadius:20,border:"none",background:"#FF6B4A",color:"#fff",fontWeight:700,cursor:"pointer"}}>{cur<questions.length-1?"Next →":"See Results"}</button></div>}
  </div>);
}

// ─── Simplify ───
function SimplifyView({ content, onMore, generating }) {
  if(!content||!content.sections) return null;
  return (<div>
    {content.sections.map((s,i)=><div key={i} style={{marginBottom:20,background:"rgba(255,255,255,0.05)",borderRadius:16,padding:20,border:"1px solid rgba(255,255,255,0.08)"}}>
      <div style={{fontSize:16,fontWeight:700,color:"#FFD93D",marginBottom:8}}>{s.title}</div>
      <div style={{fontSize:14,color:"rgba(255,255,255,0.8)",lineHeight:1.7,marginBottom:12}}>{s.simple}</div>
      {s.analogy&&<div style={{fontSize:13,color:"#4ECDC4",background:"rgba(78,205,196,0.1)",padding:12,borderRadius:10,lineHeight:1.6}}>🎯 <strong>Analogy:</strong> {s.analogy}</div>}</div>)}
    <GenerateMoreBtn onClick={onMore} loading={generating} label="Different Analogies"/>
    <TipBox color="#FFD93D" title="Feynman Technique:" text="If you can explain it simply enough for a 5-year-old, then YOU truly understand it. These simplifications help check your understanding!"/>
  </div>);
}

// ─── Summary ───
function SummaryView({ summary, onMore, generating }) {
  if(!summary||!summary.keyPoints) return null;
  return (<div>
    {summary.title&&<div style={{fontSize:16,fontWeight:700,color:"#fff",marginBottom:16}}>{summary.title}</div>}
    {summary.keyPoints.map((p,i)=><div key={i} style={{display:"flex",gap:12,marginBottom:14,alignItems:"flex-start"}}>
      <div style={{minWidth:28,height:28,borderRadius:"50%",background:"linear-gradient(135deg,#FF6B4A,#FF8A6A)",display:"flex",alignItems:"center",justifyContent:"center",fontSize:13,fontWeight:700,color:"#fff",flexShrink:0}}>{i+1}</div>
      <div style={{fontSize:14,color:"rgba(255,255,255,0.8)",lineHeight:1.7,paddingTop:3}}>{p}</div></div>)}
    {summary.keyTerms&&summary.keyTerms.length>0&&<div style={{marginTop:20,background:"rgba(255,255,255,0.05)",borderRadius:16,padding:16}}>
      <div style={{fontSize:13,fontWeight:700,color:"#A78BFA",marginBottom:10}}>📖 Key Terms</div>
      {summary.keyTerms.map((t,i)=><div key={i} style={{marginBottom:8,fontSize:13,lineHeight:1.5}}><span style={{color:"#4ECDC4",fontWeight:600}}>{t.term}</span><span style={{color:"rgba(255,255,255,0.5)"}}> — {t.definition}</span></div>)}</div>}
    <GenerateMoreBtn onClick={onMore} loading={generating} label="Different Angle"/>
  </div>);
}

// ───────────────────────────────────────────────
// MAIN APP
// ───────────────────────────────────────────────
export default function StudyBuddy() {
  const [material,setMaterial]=useState("");
  const [activeMethod,setActiveMethod]=useState(null);
  const [loading,setLoading]=useState(false);
  const [generating,setGenerating]=useState(false);
  const [showPrint,setShowPrint]=useState(false); // for "more" generation (doesn't replace main view)
  const [error,setError]=useState(null);
  const [studyData,setStudyData]=useState({});
  // Track all previously generated content so AI avoids repeats
  const historyRef = useRef({ flashcards:[], quiz:[], simplify:0, summary:0, mindmap:0 });
  const [uploadedFiles,setUploadedFiles]=useState([]);
  const [extracting,setExtracting]=useState(false);
  const [extractProgress,setExtractProgress]=useState("");
  const [fileError,setFileError]=useState(null);
  const fileInputRef=useRef(null); const contentRef=useRef(null);

  useEffect(()=>{if(activeMethod&&contentRef.current) setTimeout(()=>contentRef.current.scrollIntoView({behavior:"smooth",block:"start"}),150);},[activeMethod,loading]);

  const handleFileUpload = async (e) => {
    const files=Array.from(e.target.files); if(!files.length) return;
    setExtracting(true); setFileError(null); let allText=material;
    for(let fi=0;fi<files.length;fi++){
      const file=files[fi],cat=getFileCategory(file),icon=getFileIcon(cat,file.name);
      setExtractProgress("Reading "+(fi+1)+" of "+files.length+": "+file.name);
      let preview=null;
      if(cat==="image"){preview=await new Promise(r=>{const rd=new FileReader();rd.onload=()=>r(rd.result);rd.readAsDataURL(file);});}
      setUploadedFiles(p=>[...p,{name:file.name,category:cat,icon,preview,size:file.size}]);
      const result=await extractTextFromFile(file);
      if(result.error) setFileError(result.error);
      if(result.text) allText+=(allText?"\n\n":"")+result.text;
    }
    setMaterial(allText); setStudyData({}); historyRef.current={flashcards:[],quiz:[],simplify:0,summary:0,mindmap:0};
    setExtracting(false); setExtractProgress("");
    if(fileInputRef.current) fileInputRef.current.value="";
    if(!allText.trim()) setFileError("Couldn't extract text. Try pasting notes as text instead.");
  };

  // Build prompts that include previously seen content so AI creates NEW stuff
  const buildPrompt = (method, mat) => {
    const hist = historyRef.current;
    const avoidFlash = hist.flashcards.length > 0 ? "\n\nIMPORTANT: Do NOT repeat these questions which have already been used:\n" + hist.flashcards.map(q=>"- "+q).join("\n") + "\nCreate COMPLETELY DIFFERENT questions covering different aspects of the material." : "";
    const avoidQuiz = hist.quiz.length > 0 ? "\n\nIMPORTANT: Do NOT repeat these questions which have already been used:\n" + hist.quiz.map(q=>"- "+q).join("\n") + "\nAsk about DIFFERENT facts, use DIFFERENT question styles (cause/effect, definitions, applications, comparisons, true/false style)." : "";
    const varSimp = hist.simplify > 0 ? "\n\nThis is attempt #"+(hist.simplify+1)+". Use COMPLETELY DIFFERENT analogies than before. Try analogies from: " + ["cooking recipes","video games","building with LEGO","social media algorithms","sports training","smartphone apps","streaming playlists","online shopping"][hist.simplify % 8] + "." : "";
    const varSummary = hist.summary > 0 ? "\n\nThis is attempt #"+(hist.summary+1)+". Organise the summary from a DIFFERENT angle: " + ["chronological order","most important to least","cause and effect chains","compare and contrast","real-world applications","exam-likely topics first"][hist.summary % 6] + ". Use different wording than before." : "";
    const varMindmap = hist.mindmap > 0 ? "\n\nThis is attempt #"+(hist.mindmap+1)+". Organise the mind map from a COMPLETELY DIFFERENT perspective: " + ["by process steps","by cause and effect","by key vocabulary","by real-world examples","by difficulty level","by exam topics"][hist.mindmap % 6] + "." : "";

    switch(method) {
      case "flashcards": return 'Create flashcards from this study material. Return JSON: {"cards":[{"question":"...","answer":"..."}]}. Make 6-8 cards. Keep answers short (1-2 sentences). Cover different aspects — mix definitions, processes, examples, and application questions.' + avoidFlash + '\n\nMaterial:\n' + mat;
      case "mindmap": return 'Create a mind map from this study material. Return JSON: {"center":"Main Topic","branches":[{"topic":"Branch Name","points":["point 1","point 2","point 3"]}]}. Create 4-6 branches with 2-4 points each.' + varMindmap + '\n\nMaterial:\n' + mat;
      case "quiz": return 'Create a quiz from this material. Return JSON: {"questions":[{"question":"...","options":["A","B","C","D"],"correctIndex":0,"explanation":"..."}]}. Make exactly 5 questions. Mix question types: definitions, cause/effect, application, comparison. Use fun analogies in explanations.' + avoidQuiz + '\n\nMaterial:\n' + mat;
      case "simplify": return 'Simplify this study material for a 14-year-old. Return JSON: {"sections":[{"title":"Topic","simple":"Simple explanation","analogy":"Real-world analogy a teen would get"}]}. Break into 3-5 sections.' + varSimp + '\n\nMaterial:\n' + mat;
      case "summary": return 'Summarise this study material. Return JSON: {"title":"Topic","keyPoints":["point 1","point 2"],"keyTerms":[{"term":"Word","definition":"Simple meaning"}]}. Include 5-7 key points and important terms.' + varSummary + '\n\nMaterial:\n' + mat;
      default: return "";
    }
  };

  const generateContent = async (method, isMore) => {
    setError(null);
    if(method==="pomodoro"){setActiveMethod("pomodoro");return;}
    if(!material.trim()){setActiveMethod(method);setError("Please add some study material first! Paste text or upload a file above.");return;}
    if(!isMore && studyData[method]){setActiveMethod(method);return;}

    setActiveMethod(method);
    if(isMore) setGenerating(true); else setLoading(true);

    const mat = material.substring(0,3000);
    const prompt = buildPrompt(method, mat);
    const result = await askClaude(prompt);

    if(!result||result.error){
      if(isMore) setGenerating(false); else setLoading(false);
      if(!isMore) setError(result?result.error:"Something went wrong!");
      return;
    }

    // Track history to avoid repeats
    const hist = historyRef.current;
    if(method==="flashcards" && result.cards) {
      const newQs = result.cards.map(c=>c.question);
      hist.flashcards = [...hist.flashcards, ...newQs].slice(-40); // keep last 40
      // APPEND to existing deck instead of replacing
      if(isMore && studyData.flashcards && studyData.flashcards.cards) {
        result.cards = [...studyData.flashcards.cards, ...result.cards];
      }
    }
    if(method==="quiz" && result.questions) {
      const newQs = result.questions.map(q=>q.question);
      hist.quiz = [...hist.quiz, ...newQs].slice(-30);
    }
    if(method==="simplify") hist.simplify++;
    if(method==="summary") hist.summary++;
    if(method==="mindmap") hist.mindmap++;

    setStudyData(prev=>({...prev,[method]:result}));
    if(isMore) setGenerating(false); else setLoading(false);
  };

  const handleMore = () => { if(activeMethod) generateContent(activeMethod, true); };

  const retry = () => {
    if(activeMethod&&activeMethod!=="pomodoro"){
      setStudyData(prev=>{const c={...prev};delete c[activeMethod];return c;});
      setError(null); generateContent(activeMethod);
    }
  };

  const renderContent = () => {
    if(!activeMethod) return null;
    if(loading) return (<div style={{textAlign:"center",padding:48}}>
      <div style={{fontSize:40,marginBottom:16,animation:"bounce 1s ease-in-out infinite"}}>🧠</div>
      <div style={{fontSize:16,color:"rgba(255,255,255,0.7)",fontWeight:600}}>Generating your study material...</div>
      <div style={{fontSize:13,color:"rgba(255,255,255,0.4)",marginTop:8}}>This usually takes 5-15 seconds</div></div>);
    if(error) return <ErrorBox message={error} onRetry={material.trim()?retry:null}/>;
    switch(activeMethod){
      case "pomodoro": return <PomodoroTimer/>;
      case "flashcards": return <FlashCards cards={studyData.flashcards&&studyData.flashcards.cards} onMore={handleMore} generating={generating}/>;
      case "mindmap": return <MindMapView data={studyData.mindmap} onMore={handleMore} generating={generating}/>;
      case "quiz": return <QuizView questions={studyData.quiz&&studyData.quiz.questions} onMore={handleMore} generating={generating}/>;
      case "simplify": return <SimplifyView content={studyData.simplify} onMore={handleMore} generating={generating}/>;
      case "summary": return <SummaryView summary={studyData.summary} onMore={handleMore} generating={generating}/>;
      default: return null;
    }
  };
  const mi = activeMethod ? STUDY_METHODS.find(m=>m.id===activeMethod) : null;

  return (
    <div style={{minHeight:"100vh",background:"#12121f",color:"#fff",fontFamily:"'DM Sans','Segoe UI',sans-serif"}}>

      <div style={{padding:"32px 24px 20px",textAlign:"center"}}>
        <div style={{fontSize:13,letterSpacing:4,color:"rgba(255,255,255,0.3)",textTransform:"uppercase",marginBottom:8}}>Your AI-Powered</div>
        <h1 style={{fontSize:34,fontWeight:800,margin:0,background:"linear-gradient(135deg,#FF6B4A,#FFD93D,#4ECDC4)",WebkitBackgroundClip:"text",WebkitTextFillColor:"transparent"}}>Study Buddy</h1>
        <p style={{fontSize:14,color:"rgba(255,255,255,0.5)",marginTop:8,maxWidth:420,marginInline:"auto"}}>Paste your notes, upload photos, PDFs, or Word docs — let AI turn them into study tools 🚀</p>
      </div>

      <div style={{padding:"0 20px",maxWidth:640,margin:"0 auto"}}>
        {/* Input */}
        <div style={{background:"rgba(255,255,255,0.04)",borderRadius:20,border:"1px solid rgba(255,255,255,0.08)",padding:20,marginBottom:24}}>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:12}}>
            <label style={{fontSize:13,fontWeight:700,color:"rgba(255,255,255,0.6)",letterSpacing:1,textTransform:"uppercase"}}>📚 Your Learning Material</label>
            <button onClick={()=>{setMaterial(EXAMPLE_MATERIAL);setStudyData({});setError(null);historyRef.current={flashcards:[],quiz:[],simplify:0,summary:0,mindmap:0};}} style={{fontSize:11,padding:"4px 12px",borderRadius:12,border:"1px solid rgba(255,255,255,0.15)",background:"transparent",color:"rgba(255,255,255,0.4)",cursor:"pointer"}}>Try Example</button>
          </div>
          <textarea value={material} onChange={e=>{setMaterial(e.target.value);setStudyData({});setError(null);historyRef.current={flashcards:[],quiz:[],simplify:0,summary:0,mindmap:0};}}
            placeholder="Paste your study notes, textbook text, or topic here..." rows={5}
            style={{width:"100%",background:"rgba(0,0,0,0.3)",border:"1px solid rgba(255,255,255,0.1)",borderRadius:12,padding:14,color:"#fff",fontSize:14,resize:"vertical",fontFamily:"inherit",lineHeight:1.6,transition:"border-color 0.2s"}}/>
          {material.trim()&&<div style={{marginTop:6,fontSize:11,color:"rgba(78,205,196,0.6)",textAlign:"right"}}>✓ {material.length} chars loaded — ready to study!</div>}

          <div style={{marginTop:12,display:"flex",gap:10,alignItems:"center",flexWrap:"wrap"}}>
            <input ref={fileInputRef} type="file" accept="image/*,.pdf,.docx,.txt,.csv,.md,.pptx,.xlsx,.xls" multiple onChange={handleFileUpload} style={{display:"none"}}/>
            <button onClick={()=>fileInputRef.current&&fileInputRef.current.click()} disabled={extracting}
              style={{padding:"10px 20px",borderRadius:14,border:"1px dashed rgba(255,255,255,0.2)",background:"rgba(255,255,255,0.04)",color:"rgba(255,255,255,0.6)",cursor:extracting?"wait":"pointer",fontSize:13,display:"flex",alignItems:"center",gap:8,opacity:extracting?0.6:1}}>
              {extracting?<><Spinner/> {extractProgress||"Reading files..."}</>:"📎 Upload Files"}</button>
          </div>
          {!extracting&&uploadedFiles.length===0&&<div style={{marginTop:8,fontSize:11,color:"rgba(255,255,255,0.3)"}}>Supports: Photos, PDFs, Word (.docx), PowerPoint (.pptx), Excel (.xlsx), text files (.txt, .csv, .md)</div>}
          {uploadedFiles.length>0&&<div style={{marginTop:10,display:"flex",gap:8,flexWrap:"wrap"}}>
            {uploadedFiles.map((f,i)=><div key={i} style={{display:"flex",alignItems:"center",gap:6,padding:"6px 12px",borderRadius:12,background:"rgba(78,205,196,0.08)",border:"1px solid rgba(78,205,196,0.2)",fontSize:12,color:"rgba(255,255,255,0.7)"}}>
              {f.preview?<img src={f.preview} alt={f.name} style={{width:22,height:22,borderRadius:4,objectFit:"cover"}}/>:<span style={{fontSize:16}}>{f.icon}</span>}
              <span style={{maxWidth:120,overflow:"hidden",textOverflow:"ellipsis",whiteSpace:"nowrap"}}>{f.name}</span>
              <span style={{fontSize:10,color:"rgba(255,255,255,0.3)"}}>{f.size>1048576?(f.size/1048576).toFixed(1)+"MB":Math.round(f.size/1024)+"KB"}</span></div>)}</div>}
          {fileError&&<div style={{marginTop:10,fontSize:12,color:"#FF6B4A",background:"rgba(255,107,74,0.1)",padding:"8px 12px",borderRadius:8}}>⚠️ {fileError}</div>}
        </div>

        {/* Methods */}
        <div style={{marginBottom:24}}>
          <div style={{fontSize:13,fontWeight:700,color:"rgba(255,255,255,0.6)",letterSpacing:1,textTransform:"uppercase",marginBottom:12}}>🎯 Choose Your Study Method</div>
          <div style={{display:"grid",gridTemplateColumns:"repeat(3,1fr)",gap:10}}>
            {STUDY_METHODS.map(m=>{const isA=activeMethod===m.id,has=m.id in studyData||m.id==="pomodoro";
              return <button key={m.id} onClick={()=>generateContent(m.id)} style={{padding:"16px 8px",borderRadius:16,cursor:"pointer",textAlign:"center",transition:"all 0.2s",position:"relative",
                border:isA?"2px solid #FF6B4A":"1px solid rgba(255,255,255,0.08)",background:isA?"rgba(255,107,74,0.1)":"rgba(255,255,255,0.03)"}}>
                {has&&!isA&&<div style={{position:"absolute",top:6,right:8,width:8,height:8,borderRadius:"50%",background:"#44D4A0"}}/>}
                <div style={{fontSize:24,marginBottom:4}}>{m.icon}</div>
                <div style={{fontSize:12,fontWeight:700,color:isA?"#FF6B4A":"#fff"}}>{m.label}</div>
                <div style={{fontSize:10,color:"rgba(255,255,255,0.4)",marginTop:2}}>{m.desc}</div></button>;})}
          </div>
        </div>

        {/* Content */}
        {activeMethod&&<div ref={contentRef} style={{background:"rgba(255,255,255,0.03)",borderRadius:20,border:"1px solid rgba(255,255,255,0.08)",padding:24,marginBottom:28,animation:"fadeIn 0.3s ease-out"}}>
          <div style={{display:"flex",justifyContent:"space-between",alignItems:"center",marginBottom:20}}>
            <h2 style={{margin:0,fontSize:18,fontWeight:700}}>{mi&&mi.icon} {mi&&mi.label}</h2>
            <div style={{display:"flex",alignItems:"center",gap:8}}>
              <PrintButton method={activeMethod} studyData={studyData} onPrint={()=>setShowPrint(true)}/>
              <button onClick={()=>{setActiveMethod(null);setError(null);}} style={{background:"none",border:"none",color:"rgba(255,255,255,0.4)",cursor:"pointer",fontSize:20,padding:4}}>✕</button>
            </div></div>
          {renderContent()}
        </div>}

        {/* Tip */}
        <div style={{background:"linear-gradient(135deg,rgba(167,139,250,0.08),rgba(78,205,196,0.08))",borderRadius:16,padding:20,marginBottom:40,border:"1px solid rgba(167,139,250,0.15)"}}>
          <div style={{fontSize:14,fontWeight:700,color:"#A78BFA",marginBottom:10}}>💡 Study Strategy Tip</div>
          <div style={{fontSize:13,color:"rgba(255,255,255,0.65)",lineHeight:1.8}}>
            <strong>The best combo:</strong> Start with <strong style={{color:"#FFD93D"}}>Simplify</strong> to get the big picture, then <strong style={{color:"#4ECDC4"}}>Mind Map</strong> to see connections, <strong style={{color:"#FF6B4A"}}>Flash Cards</strong> for memorisation, then test with a <strong style={{color:"#F472B6"}}>Quiz</strong>. Hit <strong style={{color:"#4ECDC4"}}>Generate More</strong> on any method for fresh content — the AI will never repeat the same questions!
            <br/><br/>Think of it like building a house 🏠 — foundations (simplify) → structure (mind map) → bricks (flashcards) → inspection (quiz).
          </div>
        </div>
      </div>

      {/* Print Preview Overlay */}
      {showPrint && activeMethod && <PrintPreview method={activeMethod} studyData={studyData} onClose={()=>setShowPrint(false)}/>}
    </div>
  );
}
